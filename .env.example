# XEDOC Play backend. Copy to .env and never commit the real values.
PLAY_ENVIRONMENT=production
PLAY_PUBLIC_ORIGIN=https://play.xedoc.ru
PLAY_ACCESS_KEY=replace-with-a-long-private-beta-key
PLAY_COOKIE_SECRET=replace-with-at-least-32-random-characters
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLAY_TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key
PLAY_DATABASE_PATH=/var/www/play.xedoc.ru/shared/data/play.db

PLAY_COOKIE_SECURE=true
PLAY_COOKIE_DOMAIN=play.xedoc.ru
PLAY_ACCESS_TTL_HOURS=24
PLAY_SESSION_TTL_DAYS=30
PLAY_DEMO_FALLBACK=true

# Optional explicit allowlist. Even when blank, the first connected UID is pinned in SQLite.
PLAY_YANDEX_ALLOWED_UID=

# Optional. When both are blank, yandex-music 3.0.0 uses its bundled Android
# Device Flow credentials. Set both values together if you have compatible credentials.
PLAY_YANDEX_CLIENT_ID=
PLAY_YANDEX_CLIENT_SECRET=
