# Install as /etc/play.xedoc.ru/backend.env.
# Owner/mode: root:www-data 0640. Never commit the populated file.

PLAY_ENVIRONMENT=production
PLAY_PUBLIC_ORIGIN=https://play.xedoc.ru
PLAY_DATABASE_PATH=/var/www/play.xedoc.ru/shared/data/play.db
PLAY_COOKIE_SECURE=true
PLAY_COOKIE_DOMAIN=play.xedoc.ru
PLAY_ACCESS_TTL_HOURS=24
PLAY_SESSION_TTL_DAYS=30
PLAY_DEMO_FALLBACK=true

# Replace every value below before starting the service.
PLAY_ACCESS_KEY=replace-with-a-long-random-value
PLAY_COOKIE_SECRET=replace-with-at-least-32-random-characters
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLAY_TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key

# Optional explicit allowlist. The first connected UID is also pinned automatically.
PLAY_YANDEX_ALLOWED_UID=

# Optional. Set both together only when using your own compatible credentials.
PLAY_YANDEX_CLIENT_ID=
PLAY_YANDEX_CLIENT_SECRET=
